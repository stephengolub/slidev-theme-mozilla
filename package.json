{
  "name": "slidev-theme-mozilla",
  "version": "0.1.1",
  "description": "Dark Mozilla-style Slidev theme with a mint accent.",
  "keywords": ["slidev-theme", "slidev", "mozilla"],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stephengolub/slidev-theme-mozilla"
  },
  "engines": { "slidev": ">=0.48.0" },
  "slidev": {
    "colorSchema": "dark",
    "defaults": {
      "fonts": { "sans": "Inter", "mono": "Fira Code" },
      "transition": "fade",
      "mdc": true
    }
  },
  "files": ["layouts", "components", "styles", "assets", "example.md"]
}
